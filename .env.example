# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave-apenas-para-desenvolvimento-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=false

# Banco local temporário. Para migrar, altere para DATABASE_ENGINE=postgresql.
DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# PostgreSQL exclusivo do MedPrev (usado quando DATABASE_ENGINE=postgresql)
POSTGRES_DB=medprev
POSTGRES_USER=medprev
POSTGRES_PASSWORD=medprev_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# As tabelas e os dados fictícios do dump também serão importados para este
# banco. Não há uma segunda conexão durante o desenvolvimento.
