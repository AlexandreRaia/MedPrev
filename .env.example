# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave-apenas-para-desenvolvimento-local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false

# Banco local temporário. Para migrar, altere para DATABASE_ENGINE=postgresql.
DATABASE_ENGINE=sqlite
SQLITE_NAME=db.sqlite3

# PostgreSQL exclusivo do MedPrev (usado quando DATABASE_ENGINE=postgresql)
POSTGRES_DB=medprev
POSTGRES_USER=medprev
POSTGRES_PASSWORD=medprev_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SisMed: não preencher antes de confirmar o mecanismo do banco e receber
# uma credencial institucional com permissão EXCLUSIVA de leitura.
# SISMED_DATABASE_ENGINE=django.db.backends.postgresql
# SISMED_DATABASE_NAME=
# SISMED_DATABASE_USER=
# SISMED_DATABASE_PASSWORD=
# SISMED_DATABASE_HOST=
# SISMED_DATABASE_PORT=
